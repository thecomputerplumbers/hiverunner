{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiveworker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiveworker",
      "database_id": "baef55aa-e1c6-4ddc-b9f9-0de634c15a45",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_DATABASE",
        "class_name": "AppDatabase",
      },
    ],
  },
  "exports": {
    "AppDatabase": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "send_email": [{ "name": "EMAIL" }],
  // Automatic top-up looks for balances that have run low.
  "triggers": { "crons": ["*/2 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
  "account_id": "865d0c927a18e87c0a0701b8d1f18ee9",
  "vars": {
    "APP_URL": "https://hiveworkr.thecomputerplumbers.com",
    "COORDINATOR_URL": "wss://connect.hiveworkr.thecomputerplumbers.com/v1/tunnel",
    "EMAIL_FROM": "auth@thecomputerplumbers.com",
  },
  "routes": [
    {
      "pattern": "hiveworkr.thecomputerplumbers.com",
      "custom_domain": true,
    },
  ],
}
