{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiveworker-coordinator",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "865d0c927a18e87c0a0701b8d1f18ee9",
  "workers_dev": false,
  "routes": [
    // connect.hiverunner.dev is the coordinator; the old host stays for
    // daemons and route actions that still name it.
    {
      "pattern": "connect.hiverunner.dev",
      "custom_domain": true,
    },
    {
      "pattern": "connect.hiveworkr.thecomputerplumbers.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      // The same database as apps/web, which owns its migrations. This
      // Worker never applies any.
      "binding": "DB",
      "database_name": "hiveworker",
      "database_id": "baef55aa-e1c6-4ddc-b9f9-0de634c15a45",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "POOL", "class_name": "Pool" }],
  },
  "exports": {
    "Pool": { "type": "durable-object", "storage": "sqlite" },
    // Listeners run in apps/listener now. This destroys what the objects held.
    "ScaleListener": { "type": "durable-object", "state": "deleted" },
  },
  "vars": {
    // How often a pool re-checks its connected machines against D1.
    "SWEEP_SECONDS": "60",
    // apps/listener, in our cluster behind Cloudflare Tunnel tcp-k8s.
    "LISTENER_URL": "https://listener.hiverunner.dev",
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true,
}
