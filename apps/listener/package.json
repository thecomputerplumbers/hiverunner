{
  "name": "listener",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "description": "Holds GitHub scale set sessions outside Cloudflare, where a long poll costs nothing.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/main.mjs --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/github": "workspace:*",
    "@workspace/pricing": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.15.5",
    "@workspace/typescript-config": "workspace:*",
    "esbuild": "0.25.12",
    "typescript": "catalog:"
  }
}
