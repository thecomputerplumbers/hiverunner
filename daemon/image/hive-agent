#!/bin/bash
# Runs one job and powers the VM off.
#
# The host shares two directories with this VM. One, tagged hive, it can
# only read: the job's one-time runner configuration, the clock and a stop's
# reason. The other, tagged hive-out, is for what it says back: that it is
# ready, that it has taken the job, how the job went and its exit code. This
# script reads the job, runs GitHub's runner as an unprivileged user, writes
# the exit code back, and shuts down. The disk is discarded by the host
# afterwards.
set -u

in=/run/hive
out=/run/hive-out
watchdog_pid=
peak_used_kb=0
swap_peak_kb=0
saw_oom=0
saw_disk_full=0
warned_pressure=0
warned_critical=0

write_diag() {
  mem_total_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  swap_total_kb=$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  swap_free_kb=$(awk '/^SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  swap_used_kb=0
  if [ "${swap_total_kb:-0}" -gt 0 ]; then
    swap_used_kb=$((swap_total_kb - swap_free_kb))
  fi
  {
    echo "mem_total_kb=${mem_total_kb:-0}"
    echo "peak_used_kb=${peak_used_kb:-0}"
    echo "swap_total_kb=${swap_total_kb:-0}"
    echo "swap_used_kb=${swap_used_kb:-0}"
    echo "oom=${saw_oom:-0}"
    echo "disk_full=${saw_disk_full:-0}"
  } > "$out/diag.tmp" 2>/dev/null && mv "$out/diag.tmp" "$out/diag"
}

# Put a notice in the GitHub job log, if the runner is still listening, and
# always where results go and the kernel log so the host can classify a kill.
inject() {
  local kind="$1" msg="$2"
  printf '%s\n' "$msg" >> "$out/notices" 2>/dev/null || true
  echo "hive-agent: $msg" > /dev/kmsg 2>/dev/null || true
  for cmd in /proc/[0-9]*/cmdline; do
    if tr '\0' ' ' < "$cmd" 2>/dev/null | grep -q 'Runner.Worker'; then
      pid=${cmd%/cmdline}
      pid=${pid##*/}
      printf '::%s title=Hive Runner::%s\n' "$kind" "$msg" > "/proc/$pid/fd/1" 2>/dev/null || true
    fi
  done
}

host_where() {
  local host label
  host=$(tr -cd 'A-Za-z0-9._-' < "$in/host" 2>/dev/null || true)
  label=$(tr -cd 'A-Za-z0-9._-' < "$in/label" 2>/dev/null || true)
  host=${host:-guest}
  if [ -n "$label" ]; then
    echo "$host ($label)"
  else
    echo "$host"
  fi
}

sample_memory() {
  local mem_total_kb mem_avail_kb used_kb swap_total_kb swap_free_kb swap_used_kb pct where
  mem_total_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  mem_avail_kb=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  swap_total_kb=$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  swap_free_kb=$(awk '/^SwapFree:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  [ "${mem_total_kb:-0}" -gt 0 ] || return 0
  used_kb=$((mem_total_kb - mem_avail_kb))
  swap_used_kb=0
  [ "${swap_total_kb:-0}" -gt 0 ] && swap_used_kb=$((swap_total_kb - swap_free_kb))
  [ "$used_kb" -gt "${peak_used_kb:-0}" ] && peak_used_kb=$used_kb
  [ "$swap_used_kb" -gt "${swap_peak_kb:-0}" ] && swap_peak_kb=$swap_used_kb
  pct=$((used_kb * 100 / mem_total_kb))
  where=$(host_where)
  if [ "$pct" -ge 95 ] && [ "$warned_critical" -eq 0 ]; then
    warned_critical=1
    inject warning "memory pressure: $((used_kb / 1024))/$((mem_total_kb / 1024)) MB used on $where; swapping rather than killing"
  elif [ "$pct" -ge 85 ] && [ "$warned_pressure" -eq 0 ]; then
    warned_pressure=1
    inject warning "memory pressure: $((used_kb / 1024))/$((mem_total_kb / 1024)) MB used on $where"
  fi
  if dmesg 2>/dev/null | grep -qiE 'out of memory|oom-kill|invoked oom-killer'; then
    if [ "$saw_oom" -eq 0 ]; then
      saw_oom=1
      inject error "runner killed: guest OOM ($((used_kb / 1024))/$((mem_total_kb / 1024)) MB peak) on $where"
    fi
  fi
  if dmesg 2>/dev/null | grep -qi 'no space left on device'; then
    if [ "$saw_disk_full" -eq 0 ]; then
      saw_disk_full=1
      inject error "runner stopped: disk full on $where"
    fi
  fi
  write_diag
}

watch_job() {
  while [ ! -e "$out/exit" ]; do
    if [ -e "$in/stop-reason" ]; then
      reason=$(tr -cd 'a-z_' < "$in/stop-reason")
      inject error "runner stopped: ${reason:-shutdown} on $(host_where)"
      write_diag
      return
    fi
    sample_memory
    sleep 2
  done
}

finish() {
  [ -n "${watchdog_pid:-}" ] && kill "$watchdog_pid" 2>/dev/null || true
  write_diag
  # Written under another name first, so the host never reads half a file.
  echo "$1" > "$out/exit.tmp" 2>/dev/null && mv "$out/exit.tmp" "$out/exit"
  sync
  umount "$out" 2>/dev/null
  umount "$in" 2>/dev/null
  systemctl poweroff --no-block
  exit 0
}

# Compressed swap first (half of RAM), then a disk-backed file (half of RAM,
# at most 4 GiB). Memory pressure then slows down instead of killing the job.
# Soft limits only warn; nothing here sends SIGKILL.
setup_memory_headroom() {
  local mem_kb zram_bytes swap_kb
  mem_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
  [ "${mem_kb:-0}" -gt 0 ] || return 0
  zram_bytes=$((mem_kb * 1024 / 2))
  swap_kb=$((mem_kb / 2))
  [ "$swap_kb" -gt $((4 * 1024 * 1024)) ] && swap_kb=$((4 * 1024 * 1024))

  if modprobe zram num_devices=1 2>/dev/null && [ -e /sys/block/zram0/disksize ]; then
    if grep -qw zstd /sys/block/zram0/comp_algorithm 2>/dev/null; then
      echo zstd > /sys/block/zram0/comp_algorithm 2>/dev/null || true
    else
      echo lz4 > /sys/block/zram0/comp_algorithm 2>/dev/null || true
    fi
    echo "$zram_bytes" > /sys/block/zram0/disksize 2>/dev/null || true
    mkswap /dev/zram0 >/dev/null 2>&1 && swapon -p 100 /dev/zram0 || true
  fi

  if [ ! -f /swapfile ]; then
    if fallocate -l "${swap_kb}k" /swapfile 2>/dev/null \
      || dd if=/dev/zero of=/swapfile bs=1k count="$swap_kb" status=none 2>/dev/null; then
      chmod 600 /swapfile
      mkswap /swapfile >/dev/null 2>&1 || rm -f /swapfile
    fi
  fi
  [ -f /swapfile ] && swapon -p 10 /swapfile || true
  # Prefer swap over the OOM killer; do not cut a job on a soft limit.
  echo 80 > /proc/sys/vm/swappiness 2>/dev/null || true
}

mkdir -p "$in" "$out"
if ! mount -t virtiofs -o ro hive "$in" || ! mount -t virtiofs hive-out "$out"; then
  echo "hive-agent: no job share; shutting down"
  systemctl poweroff --no-block
  exit 1
fi

# The job's disk is a clone the host has grown; take the room.
resize2fs /dev/vda >/dev/null 2>&1 || true
setup_memory_headroom

# A warm VM waits here, booted, for its job to arrive.
# `ready` tells the host the boot is behind it.
: > "$out/ready"
waited=0
until [ -e "$in/jitconfig" ] || [ -e "$in/selftest" ]; do
  if [ -e "$in/stop-reason" ]; then
    finish 143
  fi
  sleep 0.2
  waited=$((waited + 1))
  # Half an hour without a job: the host has forgotten this VM.
  [ "$waited" -gt 9000 ] && finish 125
done

# The guest has no clock of its own worth trusting, and TLS needs one. The
# host writes the time beside the job; a wrong clock can only break the job.
if [ -r "$in/clock" ]; then
  date -u -s "@$(tr -cd '0-9' < "$in/clock")" >/dev/null 2>&1 || true
fi

# The host may offer this job its Actions cache, on a socket that exists
# only between this VM and the host. Actions speak HTTP to an address, so a
# relay gives the socket one on this VM's own loopback. The cache is offered
# to the job only once it has answered; otherwise the job uses GitHub's.
cache=failed
if [ -r "$in/cache" ]; then
  port=$(tr -cd '0-9' < "$in/cache")
  if [ -n "$port" ]; then
    modprobe vmw_vsock_virtio_transport >/dev/null 2>&1 || true
    socat "TCP-LISTEN:$port,bind=127.0.0.1,reuseaddr,fork" "VSOCK-CONNECT:2:$port" >/dev/null 2>&1 &
    relay=$!
    tries=0
    while [ "$tries" -lt 50 ]; do
      if curl -fsS -o /dev/null -m 2 "http://127.0.0.1:$port/hive/health" 2>/dev/null; then
        cache=ok
        break
      fi
      tries=$((tries + 1))
      sleep 0.1
    done
    if [ "$cache" = ok ]; then
      # Read by hive-node, as the runner's user.
      echo "http://127.0.0.1:$port/" > /etc/hive-results-url
      chmod 0644 /etc/hive-results-url
    else
      kill "$relay" 2>/dev/null || true
    fi
  fi
fi

if [ -e "$in/selftest" ]; then
  # No credential involved: proves boot, the share, the network, Docker
  # and the runner binary, and nothing more.
  {
    cat /etc/hive-release
    echo "OS=$(. /etc/os-release && echo "$PRETTY_NAME")"
    echo "ARCH=$(uname -m)"
    echo "KERNEL=$(uname -r)"
    echo "CPUS=$(nproc)"
    echo "MEM=$(awk '/^MemTotal:/ {printf "%dM", $2/1024}' /proc/meminfo)"
    echo "USER=$(sudo -u runner id -un)"
    echo "RUNNER=$(sudo -u runner /opt/runner/bin/Runner.Listener --version)"
    if grep -q zram /proc/swaps 2>/dev/null; then echo "ZRAM=ok"; else echo "ZRAM=missing"; fi
    if grep -q /swapfile /proc/swaps 2>/dev/null; then echo "SWAP=ok"; else echo "SWAP=missing"; fi
    # What the host handed over is not this VM's to change.
    if : > "$in/.probe" 2>/dev/null; then echo "HANDED=writable"; rm -f "$in/.probe"; else echo "HANDED=read-only"; fi
    curl -fsS -o /dev/null -m 20 https://api.github.com/zen && echo "NETWORK=ok" || echo "NETWORK=failed"
    # Whether the host offered its cache, and whether this VM reached it.
    [ -r "$in/cache" ] && echo "CACHE=$cache"
    # Docker as a job has it: the runner's user, no sudo, and an engine that
    # starts when first spoken to. One container has to start and reach
    # GitHub through Docker's own bridge. It is made from a file already on
    # this disk, so nothing is pulled and Docker Hub is not part of the test.
    if said=$(timeout 90 sudo -u runner sh -c '
      tar -c -C /usr/bin busybox | docker import - hive-selftest >/dev/null &&
      docker run --rm hive-selftest /busybox nc -w 20 api.github.com 443 </dev/null' 2>&1); then
      echo "DOCKER=ok"
    else
      echo "DOCKER=failed"
      # Why, in the last thing Docker said, on one line of the report.
      echo "DOCKER_SAID=$(printf %s "$said" | tail -n 1)"
    fi
    for node in /opt/runner/externals/node*/bin/node; do
      case "$node" in *_alpine/*) continue ;; esac
      # Each Node the runner ships is checked, and says which it is: two of
      # them printing the same line reads as one printed twice.
      which=${node#/opt/runner/externals/}
      which=${which%%/*}
      echo "NODE[$which]=$(ACTIONS_RESULTS_URL=https://results-receiver.actions.githubusercontent.com/ sudo -u runner --preserve-env=ACTIONS_RESULTS_URL "$node" -p 'process.env.ACTIONS_RESULTS_URL')"
      # An action's inputs have hyphens in their names, and its other
      # settings must arrive untouched too.
      echo "INPUTS[$which]=$(sudo -u runner env -i 'INPUT_GITHUB-TOKEN=kept' ACTIONS_RESULTS_URL=https://example.com/ "$node" -p 'process.env["INPUT_GITHUB-TOKEN"] + " " + process.env.ACTIONS_RESULTS_URL + " " + process.argv.slice(1).join(",")' a 'b c')"
    done
  } > "$out/selftest.out" 2>&1
  finish 0
fi

watch_job &
watchdog_pid=$!

jit=$(cat "$in/jitconfig")
# The host removes it once told it has been read.
: > "$out/taken"

cd /opt/runner
# A clean environment: nothing of the agent's leaks into the job. The one
# setting asks the runner to say so (exit 7) when GitHub refuses its version
# as too old; without it the runner exits 0 and the job just stays queued.
sudo -u runner -H env -i \
  HOME=/home/runner USER=runner LANG=en_US.UTF-8 \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  ACTIONS_RUNNER_RETURN_VERSION_DEPRECATED_EXIT_CODE=1 \
  /opt/runner/run.sh --jitconfig "$jit"
code=$?
unset jit
finish "$code"
